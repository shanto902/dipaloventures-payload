DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# monday.com — pitch form submissions (src/lib/monday.ts)
# Leave blank until the integration is wired up; the form fails gracefully meanwhile.
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=
MONDAY_GROUP_ID=
MONDAY_SCORE_COLUMN_ID=numeric_mm4t9dwv
MONDAY_FIT_COLUMN_ID=

# Gemini — automatic first-pass pitch scoring (src/lib/pitchScoring.ts)
# Both the explicit switch and key are required. Keep disabled until privacy,
# vendor, rubric, queue, and abuse-control reviews are complete.
PITCH_SCORING_ENABLED=false
GEMINI_API_KEY=
GEMINI_SCORING_MODEL=gemini-2.5-flash
